{
  "format": 1,
  "description": "The Phase 2 gate's cart-pole (ADR 0103, ADR 0105): a cart on a rail and a pole hinged on it, one mech.planar block, balanced upright by an LQR controller written as typed equations. The controller reads the joints and drives the cart's force; wired to the mechanism it is solved with it as one ODE. Press on the pole in the scene and drag: while it is held, a damped spring pulls the pole's centre toward the pointer (it drives the pole's load parameters, pole_fx and pole_fy); let go and the controller catches it, unless the cart's force limit (umax) cannot. Rewind and run on: the grab is recorded input and replays exactly; Runs ▸ Save run… keeps it, and simsandbox run --inputs replays it headless. The dots and short axes are the bodies' frames, drawn from the mechanism's rows: the axes are the template body_axes, drawn once a body (ADR 0113).",
  "run": {
    "dt": 0.002
  },
  "templates": {
    "body_axes": {
      "description": "A body's frame drawn as two short axes (x red, y green); bound over a mechanism's rows, it is drawn once a body.",
      "frames": {
        "body": {
          "angle": "$angle",
          "x": "$x",
          "y": "$y"
        }
      },
      "inputs": {
        "angle": {
          "kind": "rows",
          "unit": "rad"
        },
        "x": {
          "kind": "rows",
          "unit": "m"
        },
        "y": {
          "kind": "rows",
          "unit": "m"
        }
      },
      "layers": [
        {
          "bind": {
            "colour": "red",
            "width": 1.5,
            "x1": 0,
            "x2": "$length",
            "y1": 0,
            "y2": 0
          },
          "draw": "segments",
          "in": "body"
        },
        {
          "bind": {
            "colour": "green",
            "width": 1.5,
            "x1": 0,
            "x2": 0,
            "y1": 0,
            "y2": "$length"
          },
          "draw": "segments",
          "in": "body"
        }
      ],
      "params": {
        "length": {
          "unit": "m",
          "value": 0.15
        }
      },
      "type": "plot.scene",
      "unit": "m"
    },
    "cartpole": {
      "description": "A cart on a track and a pole on a hinge on it; the pole can be grabbed. It offers the frame tip, at the pole's tip.",
      "frames": {
        "cart": {
          "x": "$x",
          "y": 0.0
        },
        "pole": {
          "angle": "$theta",
          "in": "cart"
        },
        "tip": {
          "in": "pole",
          "y": 1.0
        }
      },
      "inputs": {
        "hand": {
          "description": "the pointer that grabs the pole: the model's input.pointer block",
          "kind": "pointer"
        },
        "theta": {
          "description": "the pole's angle from upright",
          "unit": "rad"
        },
        "x": {
          "description": "the cart's position along the track",
          "unit": "m"
        }
      },
      "layers": [
        {
          "bind": {
            "colour": "$cart_colour",
            "height": 0.2,
            "width": 0.4,
            "x": 0.0,
            "y": 0.0
          },
          "draw": "boxes",
          "in": "cart"
        },
        {
          "bind": {
            "colour": "$pole_colour",
            "height": 1.0,
            "width": 0.05,
            "x": 0.0,
            "y": 0.5
          },
          "draw": "boxes",
          "grab": "$hand",
          "in": "pole"
        }
      ],
      "offers": [
        "tip"
      ],
      "params": {
        "cart_colour": {
          "value": "blue"
        },
        "pole_colour": {
          "value": "orange"
        }
      },
      "type": "plot.scene",
      "unit": "m"
    }
  },
  "blocks": [
    {
      "name": "hand",
      "type": "input.pointer",
      "settings": {
        "max": "2.5",
        "min": "-2.5",
        "unit": "m"
      }
    },
    {
      "name": "cartpole",
      "type": "mech.planar",
      "bodies": [
        {
          "damping": 0.1,
          "joint": "slider",
          "kind": "prismatic",
          "mass": 1.0,
          "name": "cart",
          "parent": "ground"
        },
        {
          "centre": [
            0.0,
            0.5
          ],
          "inertia": 0.008333333333333333,
          "joint": "hinge",
          "kind": "revolute",
          "mass": 0.1,
          "name": "pole",
          "parent": "cart",
          "start": [
            0.1,
            0.0
          ]
        }
      ]
    },
    {
      "name": "control",
      "type": "eq.equations",
      "equations": [
        "# LQR for the upright pole (Q = diag(10, 1, 100, 1), R = 0.1), the force limited to umax;",
        "# while the pole is held, a damped spring pulls its centre toward the pointer",
        "input x [m]  # the cart's position",
        "input v [m/s]  # the cart's speed",
        "input th [rad]  # the pole's angle from upright",
        "input w [rad/s]  # the pole's turning rate",
        "param k1 [N/m] = -10 as tuning  # gain on the cart's position",
        "param k2 [N*s/m] = -12.134 as tuning  # gain on the cart's speed",
        "param k3 [N] = 78.104 as tuning  # gain on the pole's angle",
        "param k4 [N*s] = 18.676 as tuning  # gain on the pole's rate",
        "param umax [N] = 30 as tuning  # the most force the cart's motor gives",
        "F = min(max(-(k1*x + k2*v + k3*th + k4*w), -umax), umax) [N]  # the force on the cart",
        "input hx [m]  # the pointer, across",
        "input hy [m]  # the pointer, up",
        "input down  # 1 while the pointer is pressed",
        "input picked  # what is held: 0 the pole, -1 nothing",
        "param lh [m] = 0.5 as geometry  # from the hinge to the pole's centre",
        "param ks [N/m] = 20 as tuning  # the grab spring's stiffness",
        "param cs [N*s/m] = 2 as tuning  # the grab spring's damping",
        "held = down*(picked >= 0)  # 1 while the pole is held",
        "cx = x - lh*sin(th) [m]  # the pole's centre, across",
        "cy = lh*cos(th) [m]  # the pole's centre, up",
        "fx = held*(ks*(hx - cx) - cs*(v - lh*cos(th)*w)) [N]  # the spring's pull, across",
        "fy = held*(ks*(hy - cy) + cs*lh*sin(th)*w) [N]  # the spring's pull, up"
      ]
    }
  ],
  "outputs": [
    {
      "name": "x",
      "from": "cartpole.slider_position"
    },
    {
      "name": "theta",
      "from": "cartpole.hinge_angle"
    }
  ],
  "connections": [
    {
      "from": "cartpole.slider_position",
      "to": "control.x"
    },
    {
      "from": "cartpole.slider_speed",
      "to": "control.v"
    },
    {
      "from": "cartpole.hinge_angle",
      "to": "control.th"
    },
    {
      "from": "cartpole.hinge_rate",
      "to": "control.w"
    },
    {
      "from": "hand.x",
      "to": "control.hx"
    },
    {
      "from": "hand.y",
      "to": "control.hy"
    },
    {
      "from": "hand.down",
      "to": "control.down"
    },
    {
      "from": "hand.picked",
      "to": "control.picked"
    },
    {
      "from": "control.F",
      "to": "cartpole.slider_force"
    },
    {
      "from": "control.fx",
      "to": "cartpole.pole_fx"
    },
    {
      "from": "control.fy",
      "to": "cartpole.pole_fy"
    }
  ],
  "controls": {
    "params": {
      "cartpole.pole_mass": {
        "slider": true,
        "range": [
          0.01,
          0.5
        ],
        "pin": true
      },
      "control.umax": {
        "slider": true,
        "range": [
          0.0,
          60.0
        ],
        "pin": true
      }
    },
    "views": [
      {
        "type": "plot.scene",
        "unit": "m",
        "extent": {
          "x": [
            -2.5,
            2.5
          ],
          "y": [
            -0.8,
            1.6
          ]
        },
        "layers": [
          {
            "draw": "segments",
            "bind": {
              "colour": "grey",
              "width": 2.0,
              "x1": -2.5,
              "x2": 2.5,
              "y1": -0.1,
              "y2": -0.1
            }
          },
          {
            "draw": "template",
            "bind": {
              "hand": "hand",
              "theta": "cartpole.hinge_angle",
              "x": "cartpole.slider_position"
            },
            "name": "rig",
            "template": "cartpole"
          },
          {
            "draw": "segments",
            "bind": {
              "colour": "red",
              "width": "hand.down",
              "x1": "control.cx",
              "x2": "hand.x",
              "y1": "control.cy",
              "y2": "hand.y"
            }
          },
          {
            "draw": "points",
            "bind": {
              "colour": "grey",
              "size": 6.0,
              "x": "cartpole.x",
              "y": "cartpole.y"
            }
          },
          {
            "draw": "template",
            "bind": {
              "angle": "cartpole.angle",
              "x": "cartpole.x",
              "y": "cartpole.y"
            },
            "name": "axes",
            "template": "body_axes"
          }
        ]
      },
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": [
            "cartpole.hinge_angle",
            "cartpole.slider_position",
            "control.F"
          ]
        }
      }
    ]
  }
}
