{
  "format": 1,
  "description": "Rabbits and foxes, typed as equations (Lotka-Volterra). Prey grow, predators eat them and starve without them, and the two populations chase each other in a cycle. Edit the equations with 'Edit equations...'.",
  "run": {
    "dt": 0.01
  },
  "blocks": [
    {
      "name": "ecosystem",
      "type": "eq.equations",
      "equations": [
        "# prey grow at rate alpha and are eaten at rate beta per predator",
        "param alpha [1/s] = 1.1",
        "param beta [1/s] = 0.4",
        "# predators grow by eating (delta per prey) and die off (gamma)",
        "param delta [1/s] = 0.1",
        "param gamma [1/s] = 0.4",
        "state prey = 10",
        "state predators = 10",
        "dprey/dt = alpha*prey - beta*prey*predators",
        "dpredators/dt = delta*prey*predators - gamma*predators",
        "total = prey + predators"
      ]
    }
  ],
  "controls": {
    "params": {
      "ecosystem.alpha": {
        "slider": true,
        "range": [
          0.0,
          3.0
        ],
        "pin": true
      },
      "ecosystem.gamma": {
        "slider": true,
        "range": [
          0.0,
          2.0
        ],
        "pin": true
      }
    },
    "speed": 2.0,
    "views": [
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": [
            "ecosystem.prey",
            "ecosystem.predators"
          ]
        }
      },
      {
        "type": "plot.xy",
        "bind": {
          "colour": "t",
          "x": "ecosystem.prey",
          "y": "ecosystem.predators"
        }
      }
    ]
  }
}
