{
  "format": 1,
  "description": "A platoon: three cars follow a lead car, each matching the speed of the car ahead with its own PI controller. Each follower is the same model (a car and its controller), defined once in this file and used three times with a different mass; the gains kp and ki are model parameters all three share. Raise the gains and watch the disturbance grow or shrink down the line.",
  "run": {
    "dt": 0.05,
    "t_end": 60.0
  },
  "params": {
    "ki": {
      "value": 40.0,
      "unit": "N/m",
      "description": "Integral gain of every follower",
      "range": [
        0.0,
        400.0
      ]
    },
    "kp": {
      "value": 400.0,
      "unit": "N*s/m",
      "description": "Proportional gain of every follower",
      "range": [
        0.0,
        2000.0
      ]
    }
  },
  "models": {
    "follower": {
      "description": "A car that matches the speed of the car ahead: drag c*v, a driving force from a PI controller on the speed difference.",
      "params": {
        "kp": {
          "value": 400.0,
          "unit": "N*s/m",
          "description": "Proportional gain"
        },
        "ki": {
          "value": 40.0,
          "unit": "N/m",
          "description": "Integral gain"
        },
        "mass": {
          "value": 1000.0,
          "unit": "kg",
          "description": "Mass of the car"
        }
      },
      "blocks": [
        {
          "name": "car",
          "type": "eq.equations",
          "equations": [
            "# a car pushed by force F against drag c*v (mass m)",
            "input F [N]",
            "param m [kg] = 1000",
            "param c [N*s/m] = 50",
            "state v [m/s] = 0",
            "dv/dt = (F - c*v)/m"
          ],
          "params": {
            "m": "mass"
          }
        },
        {
          "name": "control",
          "type": "eq.equations",
          "equations": [
            "# PI control towards the speed of the car ahead",
            "input lead [m/s], v [m/s]",
            "param kp [N*s/m] = 400",
            "param ki [N/m] = 40",
            "e = lead - v",
            "state I [m] = 0",
            "dI/dt = e",
            "F = kp*e + ki*I [N]"
          ],
          "params": {
            "kp": "kp",
            "ki": "ki"
          }
        },
        {
          "name": "lead",
          "type": "input.value",
          "settings": {
            "unit": "m/s"
          }
        }
      ],
      "connections": [
        {
          "from": "car.v",
          "to": "control.v"
        },
        {
          "from": "control.F",
          "to": "car.F"
        },
        {
          "from": "lead.y",
          "to": "control.lead"
        }
      ],
      "outputs": [
        {
          "name": "v",
          "from": "car.v"
        }
      ]
    }
  },
  "blocks": [
    {
      "name": "leader",
      "type": "eq.equations",
      "equations": [
        "# the lead car speeds up towards its target, then holds it",
        "param T [s] = 5",
        "param target [m/s] = 25",
        "state v [m/s] = 0",
        "dv/dt = (target - v)/T [m/s^2]"
      ]
    },
    {
      "name": "car1",
      "params": {
        "kp": "kp",
        "ki": "ki",
        "mass": 1000.0
      },
      "model": "follower"
    },
    {
      "name": "car2",
      "params": {
        "kp": "kp",
        "ki": "ki",
        "mass": 1500.0
      },
      "model": "follower"
    },
    {
      "name": "car3",
      "params": {
        "kp": "kp",
        "ki": "ki",
        "mass": 2500.0
      },
      "model": "follower"
    }
  ],
  "connections": [
    {
      "from": "leader.v",
      "to": "car1/lead"
    },
    {
      "from": "car1/v",
      "to": "car2/lead"
    },
    {
      "from": "car2/v",
      "to": "car3/lead"
    }
  ],
  "controls": {
    "params": {
      "kp": {
        "slider": true,
        "pin": true,
        "range": [
          0.0,
          2000.0
        ]
      },
      "ki": {
        "slider": true,
        "pin": true,
        "range": [
          0.0,
          400.0
        ]
      },
      "leader.target": {
        "slider": true,
        "pin": true,
        "range": [
          0.0,
          40.0
        ]
      }
    },
    "speed": 4.0,
    "views": [
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": [
            "leader.v",
            "car1/car.v",
            "car2/car.v",
            "car3/car.v"
          ]
        }
      }
    ]
  }
}
