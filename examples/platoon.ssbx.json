{
  "format": 1,
  "description": "A platoon: three cars follow a lead car, each matching the speed of the car ahead with its own PI controller. Each follower is the same subsystem (a car and its controller) used three times with a different mass; the gains kp and ki are model parameters all three share. Raise the gains and watch the disturbance grow or shrink down the line.",
  "run": {
    "dt": 0.05,
    "t_end": 60.0
  },
  "params": {
    "ki": {
      "value": 40.0,
      "unit": "N·s^-1·m^-1",
      "description": "Integral gain of every follower",
      "range": [0.0, 400.0]
    },
    "kp": {
      "value": 400.0,
      "unit": "N·s·m^-1",
      "description": "Proportional gain of every follower",
      "range": [0.0, 2000.0]
    }
  },
  "subsystems": {
    "follower": {
      "description": "A car that matches the speed of the car ahead: drag c*v, a driving force from a PI controller on the speed difference.",
      "params": {
        "kp": {"value": 400.0, "description": "Proportional gain"},
        "ki": {"value": 40.0, "description": "Integral gain"},
        "mass": {"value": 1000.0, "unit": "kg", "description": "Mass of the car"}
      },
      "inputs": [{"name": "lead", "to": ["control.lead"]}],
      "outputs": [{"name": "v", "from": "car.v"}],
      "blocks": [
        {
          "name": "car",
          "type": "eq.equations",
          "method": {"name": "rk4"},
          "equations": ["# a car pushed by force F against drag c*v (mass m)", "input F", "dv/dt = (F - c*v)/m"],
          "params": {"c": 50.0, "m": "mass", "v0": 0.0}
        },
        {
          "name": "control",
          "type": "eq.equations",
          "method": {"name": "rk4"},
          "equations": ["# PI control towards the speed of the car ahead", "input lead, v", "e = lead - v", "dI/dt = e", "F = kp*e + ki*I"],
          "params": {"kp": "kp", "ki": "ki", "I0": 0.0}
        }
      ],
      "connections": [
        {"from": "car.v", "to": "control.v"},
        {"from": "control.F", "to": "car.F"}
      ]
    }
  },
  "blocks": [
    {
      "name": "leader",
      "type": "eq.equations",
      "method": {"name": "rk4"},
      "equations": ["# the lead car speeds up towards its target, then holds it", "dv/dt = (target - v)/T"],
      "params": {"T": 5.0, "target": 25.0, "v0": 0.0}
    },
    {"name": "car1", "type": "follower", "params": {"kp": "kp", "ki": "ki", "mass": 1000.0}},
    {"name": "car2", "type": "follower", "params": {"kp": "kp", "ki": "ki", "mass": 1500.0}},
    {"name": "car3", "type": "follower", "params": {"kp": "kp", "ki": "ki", "mass": 2500.0}}
  ],
  "connections": [
    {"from": "leader.v", "to": "car1.lead"},
    {"from": "car1.v", "to": "car2.lead"},
    {"from": "car2.v", "to": "car3.lead"}
  ],
  "controls": {
    "params": {
      "kp": {"slider": true, "range": [0.0, 2000.0]},
      "ki": {"slider": true, "range": [0.0, 400.0]},
      "leader.target": {"slider": true, "range": [0.0, 40.0]}
    },
    "speed": 4.0,
    "views": [
      {
        "type": "plot.xy",
        "bind": {"x": "t", "y": ["leader.v", "car1/car.v", "car2/car.v", "car3/car.v"]}
      }
    ]
  }
}
