{
  "format": 1,
  "description": "The driven, damped spring of the resonance example, swept over two parameters at once: the driving frequency w and the damping c. Left: the amplitude of the steady swing over both, coloured on a log scale; the bright ridge at w ≈ 1 is the resonance, sharpest and tallest where damping is low. Middle: the same as a surface, heights on a log scale; drag to turn it. Right: a cut filter cuts the map at four dampings, the classic family of resonance curves. Change m or k and the ridge moves; edit the cuts under Data….",
  "run": {
    "dt": 0.01
  },
  "sample": {
    "design": "grid",
    "params": [
      {
        "param": "spring.w",
        "range": [
          0.0,
          3.0
        ],
        "points": 200
      },
      {
        "param": "spring.c",
        "range": [
          0.02,
          1.0
        ],
        "points": 120
      }
    ]
  },
  "blocks": [
    {
      "name": "spring",
      "type": "eq.equations",
      "method": {
        "name": "evaluate"
      },
      "equations": [
        "# steady swing of a driven, damped spring (mass m, stiffness k, damping c, force F)",
        "amplitude = F/sqrt((k - m*w^2)^2 + (c*w)^2)",
        "lag = atan2(c*w, k - m*w^2)"
      ],
      "params": {
        "F": 1.0,
        "c": 0.2,
        "k": 1.0,
        "m": 1.0,
        "w": 1.0
      }
    }
  ],
  "controls": {
    "params": {
      "spring.c": {
        "slider": true,
        "range": [
          0.02,
          2.0
        ],
        "pin": true
      },
      "spring.m": {
        "slider": true,
        "range": [
          0.2,
          4.0
        ],
        "pin": true
      }
    },
    "views": [
      {
        "type": "plot.heatmap",
        "bind": {
          "field": "grid.spring.amplitude",
          "x": "grid.spring.w",
          "y": "grid.spring.c"
        },
        "style": {
          "log_colour": 1.0
        }
      },
      {
        "type": "plot.surface",
        "bind": {
          "field": "grid.spring.amplitude",
          "x": "grid.spring.w",
          "y": "grid.spring.c"
        },
        "style": {
          "log_scale": 1.0
        },
        "camera": {
          "yaw": -0.6,
          "pitch": 0.35,
          "zoom": 1.0
        }
      },
      {
        "type": "plot.profile",
        "bind": {
          "x": "cuts1.x",
          "y": [
            "cuts1[0]",
            "cuts1[1]",
            "cuts1[2]",
            "cuts1[3]"
          ]
        }
      }
    ],
    "filters": [
      {
        "name": "cuts1",
        "type": "cut",
        "inputs": [
          "grid.spring.amplitude"
        ],
        "at": [
          0.05,
          0.1,
          0.2,
          0.5
        ],
        "interpolation": "bilinear",
        "mode": "along_x"
      }
    ]
  }
}
