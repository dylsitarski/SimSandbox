{
  "format": 1,
  "description": "The driven, damped spring of the resonance example, studied over two parameters at once: the driving frequency w and the damping c, a grid of 200 × 120 points whose results are 2D fields over both. Left: the amplitude of the steady swing, coloured on a log scale; the bright ridge at w ≈ 1 is the resonance, sharpest and tallest where damping is low. Middle: the same as a surface, heights on a log scale; drag to turn it. Right: a cut filter cuts the map at four dampings, the classic family of resonance curves. Change the mass m (the study's parameter) and the ridge moves; edit the cuts under Data….",
  "models": {
    "spring": {
      "blocks": [
        {
          "equations": [
            "# steady swing of a driven, damped spring: mass m, stiffness k, damping c, force F at frequency w",
            "param F [N] = 1",
            "param k [N/m] = 1",
            "param c [N*s/m]",
            "param m [kg]",
            "param w [rad/s]",
            "amplitude = F/sqrt((k - m*w^2)^2 + (c*w)^2) [m]",
            "lag = atan2(c*w, k - m*w^2) [rad]"
          ],
          "name": "spring",
          "params": {
            "c": "c",
            "m": "m",
            "w": "w"
          },
          "type": "eq.equations"
        }
      ],
      "description": "A driven, damped spring's steady swing: formulas, nothing in time. Its parameters c (damping), m (mass) and w (driving frequency) are set by whatever uses or studies it.",
      "params": {
        "c": {
          "unit": "N*s/m",
          "value": 0.2
        },
        "m": {
          "unit": "kg",
          "value": 1.0
        },
        "w": {
          "unit": "rad/s",
          "value": 1.0
        }
      }
    }
  },
  "blocks": [
    {
      "name": "map",
      "type": "study",
      "model": "spring",
      "sample": {
        "design": "grid",
        "params": [
          {
            "param": "w",
            "range": [
              0.0,
              3.0
            ],
            "points": 200
          },
          {
            "param": "c",
            "range": [
              0.02,
              1.0
            ],
            "points": 120
          }
        ]
      },
      "params": {
        "m": 1.0
      }
    }
  ],
  "controls": {
    "params": {
      "map.m": {
        "slider": true,
        "range": [
          0.2,
          4.0
        ],
        "pin": true
      }
    },
    "views": [
      {
        "type": "plot.heatmap",
        "bind": {
          "field": "map.spring_amplitude",
          "x": "map.w",
          "y": "map.c"
        },
        "style": {
          "log_colour": 1.0
        }
      },
      {
        "type": "plot.surface",
        "bind": {
          "field": "map.spring_amplitude",
          "x": "map.w",
          "y": "map.c"
        },
        "style": {
          "log_scale": 1.0
        },
        "camera": {
          "yaw": -0.6,
          "pitch": 0.35,
          "zoom": 1.0
        }
      },
      {
        "type": "plot.profile",
        "bind": {
          "x": "cuts1.x",
          "y": [
            "cuts1[0]",
            "cuts1[1]",
            "cuts1[2]",
            "cuts1[3]"
          ]
        }
      }
    ],
    "filters": [
      {
        "name": "cuts1",
        "type": "cut",
        "inputs": [
          "map.spring_amplitude"
        ],
        "at": [
          0.05,
          0.1,
          0.2,
          0.5
        ],
        "interpolation": "bilinear",
        "mode": "along_x"
      }
    ]
  }
}
