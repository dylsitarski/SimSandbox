          "state": [
            0.0,
            0.15,
            0.0,
            0.0
          ]
        }
      }
    },
    {
      "name": "right",
      "file": "cartpole.ssbx.json",
      "starts": {
        "cartpole": {
          "state": [
            0.0,
            -0.3,
            0.0,
            0.0
          ]
        }
      }
    }
  ],
  "controls": {
    "views": [
      {
        "type": "plot.scene",
        "unit": "m",
        "extent": {
          "x": [
            -5,
            5
          ],
          "y": [
            -0.8,
            1.6
          ]
        },
        "frames": {
          "left_track": {
            "x": -2.5,
            "y": 0.0
          },
          "right_track": {
            "x": 2.5,
            "y": 0.0
          }
        },
        "layers": [
          {
