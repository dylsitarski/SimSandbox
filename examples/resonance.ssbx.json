{
  "format": 1,
  "description": "A spring pushed back and forth: how strongly it swings at each driving frequency w. No time here: the outputs are formulas, swept across w. Lower the damping c and watch the resonance peak grow.",
  "run": {
    "dt": 0.01
  },
  "blocks": [
    {
      "name": "spring",
      "type": "eq.equations",
      "method": {
        "name": "evaluate"
      },
      "equations": [
        "# steady swing of a driven, damped spring (mass m, stiffness k, damping c, force F)",
        "amplitude = F/sqrt((k - m*w^2)^2 + (c*w)^2)",
        "lag = atan2(c*w, k - m*w^2)"
      ],
      "params": {
        "F": 1.0,
        "c": 0.2,
        "k": 1.0,
        "m": 1.0,
        "w": 1.0
      }
    }
  ],
  "controls": {
    "params": {
      "spring.c": {
        "slider": true,
        "range": [
          0.02,
          2.0
        ]
      },
      "spring.m": {
        "slider": true,
        "range": [
          0.2,
          4.0
        ]
      }
    },
    "views": [
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": "spring.amplitude"
        }
      },
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": "spring.lag"
        }
      }
    ],
    "sweep": {
      "param": "spring.w",
      "range": [
        0.0,
        3.0
      ],
      "points": 600
    }
  }
}
