{
  "format": 1,
  "description": "A spring pushed back and forth: how strongly it swings at each driving frequency w. No time here: the outputs are formulas, evaluated at 600 values of w (the sample section). Lower the damping c and watch the resonance peak grow.",
  "sample": {
    "design": "grid",
    "params": [
      {
        "param": "spring.w",
        "range": [
          0.0,
          3.0
        ],
        "points": 600
      }
    ]
  },
  "blocks": [
    {
      "name": "spring",
      "type": "eq.equations",
      "equations": [
        "# steady swing of a driven, damped spring: mass m, stiffness k, damping c, force F at frequency w",
        "param F [N] = 1",
        "param m [kg] = 1",
        "param k [N/m] = 1",
        "param c [N*s/m] = 0.2",
        "param w [rad/s] = 1",
        "amplitude = F/sqrt((k - m*w^2)^2 + (c*w)^2) [m]",
        "lag = atan2(c*w, k - m*w^2) [rad]"
      ]
    }
  ],
  "controls": {
    "params": {
      "spring.c": {
        "slider": true,
        "range": [
          0.02,
          2.0
        ],
        "pin": true
      },
      "spring.m": {
        "slider": true,
        "range": [
          0.2,
          4.0
        ],
        "pin": true
      }
    },
    "views": [
      {
        "type": "plot.xy",
        "bind": {
          "x": "spring.w",
          "y": "spring.amplitude"
        }
      },
      {
        "type": "plot.xy",
        "bind": {
          "x": "spring.w",
          "y": "spring.lag"
        }
      }
    ]
  }
}
