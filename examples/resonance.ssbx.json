{
  "format": 1,
  "description": "A spring pushed back and forth: how strongly it swings at each driving frequency w. The spring is a model of formulas, nothing in time; the study `curve` evaluates it at 600 values of w. Its damping c and mass m are the study's parameters, set by the sliders: lower c and watch the resonance peak grow. Open the study's node to see and edit the spring.",
  "models": {
    "spring": {
      "blocks": [
        {
          "equations": [
            "# steady swing of a driven, damped spring: mass m, stiffness k, damping c, force F at frequency w",
            "param F [N] = 1",
            "param k [N/m] = 1",
            "param c [N*s/m]",
            "param m [kg]",
            "param w [rad/s]",
            "amplitude = F/sqrt((k - m*w^2)^2 + (c*w)^2) [m]",
            "lag = atan2(c*w, k - m*w^2) [rad]"
          ],
          "name": "spring",
          "params": {
            "c": "c",
            "m": "m",
            "w": "w"
          },
          "type": "eq.equations"
        }
      ],
      "description": "A driven, damped spring's steady swing: formulas, nothing in time. Its parameters c (damping), m (mass) and w (driving frequency) are set by whatever uses or studies it.",
      "params": {
        "c": {
          "unit": "N*s/m",
          "value": 0.2
        },
        "m": {
          "unit": "kg",
          "value": 1.0
        },
        "w": {
          "unit": "rad/s",
          "value": 1.0
        }
      }
    }
  },
  "blocks": [
    {
      "name": "curve",
      "type": "study",
      "model": "spring",
      "sample": {
        "design": "grid",
        "params": [
          {
            "param": "w",
            "range": [
              0.0,
              3.0
            ],
            "points": 600
          }
        ]
      },
      "params": {
        "c": 0.2,
        "m": 1.0
      }
    }
  ],
  "controls": {
    "params": {
      "curve.c": {
        "slider": true,
        "range": [
          0.02,
          2.0
        ],
        "pin": true
      },
      "curve.m": {
        "slider": true,
        "range": [
          0.2,
          4.0
        ],
        "pin": true
      }
    },
    "views": [
      {
        "type": "plot.profile",
        "bind": {
          "x": "curve.w",
          "y": "curve.spring_amplitude"
        }
      },
      {
        "type": "plot.profile",
        "bind": {
          "x": "curve.w",
          "y": "curve.spring_lag"
        }
      }
    ]
  }
}
