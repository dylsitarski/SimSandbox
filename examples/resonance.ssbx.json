{
  "format": 1,
  "description": "A spring pushed back and forth: how strongly it swings at each driving frequency w. The spring is a model of formulas, nothing in time; the study `curve` evaluates it at 600 values of w. Its damping c and mass m are inputs, set by the sliders: lower c and watch the resonance peak grow. Open the study's node to see and edit the spring.",
  "models": {
    "spring": {
      "blocks": [
        {
          "name": "c",
          "settings": {
            "unit": "N*s/m"
          },
          "type": "input.value"
        },
        {
          "name": "m",
          "settings": {
            "unit": "kg"
          },
          "type": "input.value"
        },
        {
          "equations": [
            "# steady swing of a driven, damped spring: mass m, stiffness k, damping c, force F at frequency w",
            "input c [N*s/m], m [kg]",
            "param F [N] = 1",
            "param k [N/m] = 1",
            "param w [rad/s] = 1",
            "amplitude = F/sqrt((k - m*w^2)^2 + (c*w)^2) [m]",
            "lag = atan2(c*w, k - m*w^2) [rad]"
          ],
          "name": "spring",
          "type": "eq.equations"
        }
      ],
      "connections": [
        {
          "from": "c.y",
          "to": "spring.c"
        },
        {
          "from": "m.y",
          "to": "spring.m"
        }
      ],
      "description": "A driven, damped spring's steady swing: formulas, nothing in time. Its inputs: the damping c and the mass m."
    }
  },
  "blocks": [
    {
      "name": "c",
      "type": "input.value",
      "settings": {
        "unit": "N*s/m"
      },
      "params": {
        "y": 0.2
      }
    },
    {
      "name": "m",
      "type": "input.value",
      "settings": {
        "unit": "kg"
      },
      "params": {
        "y": 1.0
      }
    },
    {
      "name": "curve",
      "type": "study",
      "model": "spring",
      "sample": {
        "design": "grid",
        "params": [
          {
            "param": "spring.w",
            "range": [
              0.0,
              3.0
            ],
            "points": 600
          }
        ]
      }
    }
  ],
  "connections": [
    {
      "from": "c.y",
      "to": "curve.c"
    },
    {
      "from": "m.y",
      "to": "curve.m"
    }
  ],
  "controls": {
    "params": {
      "c.y": {
        "slider": true,
        "range": [
          0.02,
          2.0
        ],
        "pin": true
      },
      "m.y": {
        "slider": true,
        "range": [
          0.2,
          4.0
        ],
        "pin": true
      }
    },
    "views": [
      {
        "type": "plot.profile",
        "bind": {
          "x": "curve.spring_w",
          "y": "curve.spring_amplitude"
        }
      },
      {
        "type": "plot.profile",
        "bind": {
          "x": "curve.spring_w",
          "y": "curve.spring_lag"
        }
      }
    ]
  }
}
