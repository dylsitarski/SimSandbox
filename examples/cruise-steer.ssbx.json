{
  "format": 1,
  "description": "Steer the cruise-control car with keys (ADR 0058): hold the Up arrow to push the car or the Down arrow to brake it (driver, an input.value of up to 3000 N), and watch the PI controller fight back towards its target speed. Every press is recorded: rewind and run on to replay it exactly, or keep it with Runs ▸ Save run…. The cruise-control example without the driver explains the controller.",
  "run": {
    "dt": 0.05,
    "t_end": 60.0
  },
  "blocks": [
    {
      "name": "car",
      "type": "eq.equations",
      "method": {
        "name": "rk4",
        "substeps": 1.0
      },
      "equations": [
        "# a car pushed by force F (and the driver's Fd) against drag c*v (mass m)",
        "input F [N]",
        "input Fd [N]",
        "param m [kg] = 1000",
        "param c [N*s/m] = 50",
        "state v [m/s]",
        "dv/dt = (F + Fd - c*v)/m"
      ],
      "params": {
        "c": 50.0,
        "m": 1000.0,
        "v0": 0.0
      }
    },
    {
      "name": "cruise",
      "type": "eq.equations",
      "method": {
        "name": "rk4",
        "substeps": 1.0
      },
      "equations": [
        "# PI control towards the target speed",
        "input v [m/s]",
        "param target [m/s] = 25",
        "param kp [N*s/m] = 400",
        "param ki [N/m] = 40",
        "e = target - v",
        "state I [m]",
        "dI/dt = e",
        "F = kp*e + ki*I [N]"
      ],
      "params": {
        "I0": 0.0,
        "ki": 40.0,
        "kp": 400.0,
        "target": 25.0
      }
    },
    {
      "name": "driver",
      "type": "input.value",
      "method": {
        "name": "held"
      },
      "settings": {
        "max": "3000",
        "min": "-3000",
        "unit": "N"
      }
    }
  ],
  "connections": [
    {
      "from": "car.v",
      "to": "cruise.v"
    },
    {
      "from": "cruise.F",
      "to": "car.F"
    },
    {
      "from": "driver.y",
      "to": "car.Fd"
    }
  ],
  "controls": {
    "params": {
      "cruise.ki": {
        "slider": true,
        "range": [
          0.0,
          400.0
        ],
        "pin": true
      },
      "cruise.kp": {
        "slider": true,
        "range": [
          0.0,
          2000.0
        ],
        "pin": true
      },
      "cruise.target": {
        "slider": true,
        "range": [
          0.0,
          40.0
        ],
        "pin": true
      }
    },
    "speed": 4.0,
    "views": [
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": "car.v"
        }
      },
      {
        "type": "plot.xy",
        "bind": {
          "x": "t",
          "y": [
            "cruise.F",
            "driver.y"
          ]
        }
      }
    ],
    "inputs": {
      "driver": {
        "keys": [
          "ArrowDown",
          "ArrowUp"
        ]
      }
    }
  }
}
