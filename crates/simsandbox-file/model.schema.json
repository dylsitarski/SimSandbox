{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylsitarski/SimSandbox/blob/main/crates/simsandbox-file/model.schema.json",
  "title": "SimSandbox model file",
  "description": "Format version 1. See docs/decisions/0007-json-model-files.md and docs/decisions/0012-controls-in-model-files.md and docs/decisions/0013-run-section.md and docs/decisions/0023-automatic-fusion.md.",
  "type": "object",
  "required": ["format", "blocks"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "description": { "type": "string" },
    "run": { "$ref": "#/$defs/run" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "fusion": {
      "enum": ["auto", "off"],
      "default": "auto",
      "description": "auto: connected continuous equation blocks with identical methods are solved together as one system; off: only 'groups' are (ADR 0023)."
    },
    "groups": {
      "type": "array",
      "description": "Blocks solved together as one system with the given method, overriding their own (ADR 0023).",
      "items": {
        "type": "object",
        "required": ["blocks", "method"],
        "additionalProperties": false,
        "properties": {
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/name" }
          },
          "method": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string" } },
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "controls": { "$ref": "#/$defs/controls" }
  },
  "$defs": {
    "run": {
      "type": "object",
      "description": "Settings that affect results (ADR 0013). Invalid values are load errors.",
      "additionalProperties": false,
      "properties": {
        "dt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.01,
          "description": "Simulated seconds per communication step."
        },
        "t_end": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Where batch runs stop and where the app pauses."
        }
      }
    },
    "sweepAxis": {
      "type": "object",
      "required": ["param"],
      "properties": {
        "param": { "$ref": "#/$defs/ref" },
        "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "points": { "type": "integer", "minimum": 2, "maximum": 100000 }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[^.]+$",
      "description": "Unique block name; no '.'."
    },
    "ref": {
      "type": "string",
      "pattern": "^[^.]+\\..+$",
      "description": "'block.port' or 'block.param'."
    },
    "block": {
      "type": "object",
      "required": ["name", "type", "method"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": {
          "type": "string",
          "description": "Registered block type, namespaced by domain, e.g. 'eq.lorenz'."
        },
        "method": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string" } },
          "additionalProperties": { "type": "number" },
          "description": "Method name plus numeric options, e.g. {\"name\": \"rk4\", \"substeps\": 4}."
        },
        "equations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Equations of an 'eq.equations' block, one per line: 'dx/dt = ...' (or \"x' = ...\") for a state, 'name = ...' for a defined quantity (ADR 0017)."
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "Values in each parameter's declared unit; omitted parameters take their defaults."
        }
      }
    },
    "connection": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/ref" },
        "to": { "$ref": "#/$defs/ref" }
      }
    },
    "controls": {
      "type": "object",
      "description": "How the model is meant to be explored. Never affects results; invalid entries are ignored with a warning.",
      "properties": {
        "params": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ref" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "slider": { "type": "boolean" },
              "range": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Simulated seconds per wall-clock second."
        },
        "plots": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        },
        "filters": {
          "type": "array",
          "description": "Filters turning recorded data into new signals and fields (ADR 0030, ADR 0032). Each names its inputs; order carries no meaning.",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "type": { "enum": ["expression", "cut"] },
              "inputs": { "type": "array", "items": { "type": "string" } },
              "expr": { "type": "string", "description": "expression: over recorded signals, other expressions, parameters ('block.param') and 't'." },
              "mode": { "enum": ["along_x", "along_y", "free"], "description": "cut (ADR 0031): along x at fixed y values, along y at fixed x values, or free lines." },
              "at": { "type": "array", "items": { "type": "number" }, "description": "cut along x or y: the fixed values, one per cut." },
              "lines": { "type": "array", "description": "cut along free lines: end points [[x0, y0], [x1, y1]] per cut." },
              "whole": { "type": "boolean", "default": true, "description": "cut: the whole field (along x or y) or lines extended to the grid's edges (free)." },
              "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "interpolation": { "enum": ["bilinear", "nearest"], "default": "bilinear" }
            }
          }
        },
        "signals": {
          "type": "object",
          "description": "Derived signals as written before filters: name to expression. Still read; converted into expression filters (ADR 0030).",
          "additionalProperties": { "type": "string" }
        },
        "sweep": {
          "description": "The parameters swept when the model has no states: one (ADR 0021) or a list of two, giving every output as a grid over both (ADR 0022). Points default to 400 for one parameter and 100 each for two; two may ask for at most 250000 evaluations.",
          "oneOf": [
            { "$ref": "#/$defs/sweepAxis" },
            { "type": "array", "items": { "$ref": "#/$defs/sweepAxis" }, "minItems": 1, "maxItems": 2 }
          ]
        },
        "views": {
          "type": "array",
          "description": "Views the model opens with; the app shows the first (ADR 0015).",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "description": "Registered view type, e.g. 'plot.xy', 'plot.3d' ('plot.time' and 'plot.phase' are read and converted to 'plot.xy', ADR 0018)." },
              "bind": {
                "type": "object",
                "description": "Slot name to signal: 't', 'block.port' (scalar) or 'block.port[i]'; a list for slots that take several.",
                "additionalProperties": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" } }
                  ]
                }
              },
              "style": { "type": "object", "additionalProperties": { "type": "number" } },
              "camera": {
                "type": "object",
                "required": ["yaw", "pitch", "zoom"],
                "properties": {
                  "yaw": { "type": "number" },
                  "pitch": { "type": "number" },
                  "zoom": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        "view": {
          "type": "object",
          "description": "Deprecated single view (ADR 0014); read and converted into 'views', never written.",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["time", "phase", "3d"] },
            "axes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^.]+\\..+$",
                "description": "'block.port' for a scalar output, 'block.port[i]' for a vector element."
              },
              "description": "Two axes for 'phase', three for '3d', none for 'time'."
            },
            "camera": {
              "type": "object",
              "required": ["yaw", "pitch", "zoom"],
              "properties": {
                "yaw": { "type": "number" },
                "pitch": { "type": "number" },
                "zoom": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
