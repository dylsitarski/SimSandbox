{
  "format": 1,
  "description": "Block and subsystem port places written 'at', before ADR 0052 named every node's place 'canvas'.",
  "run": {"dt": 0.01},
  "subsystems": {
    "lag": {
      "inputs": [{"name": "u", "to": ["f.u"], "at": [-200.0, 0.0]}],
      "outputs": [{"name": "y", "from": "f.x", "at": [300.0, 0.0]}],
      "blocks": [
        {"name": "f", "type": "eq.equations", "method": {"name": "rk4"},
         "equations": ["input u", "dx/dt = u - x"], "at": [0.0, 0.0]}
      ]
    }
  },
  "blocks": [
    {"name": "ramp", "type": "eq.equations", "method": {"name": "rk4"},
     "equations": ["dr/dt = 1"], "at": [0.0, 40.0]},
    {"name": "a", "type": "lag", "at": [260.0, 40.0]}
  ],
  "connections": [{"from": "ramp.r", "to": "a.u"}]
}
